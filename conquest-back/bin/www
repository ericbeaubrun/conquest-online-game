#!/usr/bin/env node

/**
 * Dépendances (ESM).
 */

import http from 'http';
import createDebug from 'debug';
import { Server as SocketIOServer } from 'socket.io';
import app from '../app.js';
import { attachGameServer } from '../online/gameSocket.js';
import { connectDb, MONGODB_URI_SAFE, maskCredentials } from '../online/db.js';

const debug = createDebug('conquest-game-server:server');

/**
 * Port depuis l'environnement (défaut 3000).
 */

const port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Serveur HTTP + socket.io attaché dessus. CORS ouvert pour qu'un client React
 * servi ailleurs (ex. Vite sur :5173) puisse se connecter en développement.
 */

const server = http.createServer(app);
const io = new SocketIOServer(server, {
    cors: { origin: '*' },
    // Compression des messages WebSocket. DÉSACTIVÉE par défaut en socket.io v4,
    // alors que l'état de jeu diffusé est du JSON très répétitif : mesuré à
    // −95 % de volume sortant sur une partie complète, et −99 % combinée à
    // l'allègement du payload (voir `serializeStateWire`).
    //
    // Le gain tient à deux choses qu'il ne faut PAS « optimiser » :
    //  - la fenêtre de 32 Ko par défaut (`windowBits: 15`). La réduire pour
    //    économiser de la mémoire annule presque tout le bénéfice : un état
    //    pèse ~36 Ko, donc avec une fenêtre plus petite le message précédent
    //    sort de portée et ne sert plus de dictionnaire (mesuré : 0,33 Mo
    //    contre 3,3 Mo par partie).
    //  - la conservation du contexte entre messages, que ws négocie par défaut.
    //
    // Contrepartie assumée : ~256 Ko de contexte zlib PAR CONNEXION. C'est un
    // coût borné par le nombre de joueurs simultanés (et non par le temps),
    // contrairement aux fuites corrigées par ailleurs. `threshold` évite de
    // compresser les petits messages de lobby, où le calcul ne se rentabilise pas.
    perMessageDeflate: {
        threshold: 1024,
        concurrencyLimit: 10,
        zlibDeflateOptions: { level: 6, chunkSize: 16 * 1024 },
    },
});
attachGameServer(io);

/**
 * Démarrage : on se connecte D'ABORD à MongoDB (indispensable aux lobbies et à
 * la persistance), puis seulement on écoute. Si Mongo est injoignable, on
 * s'arrête avec un message clair plutôt que d'accepter des connexions bancales.
 */

try {
    await connectDb();
} catch (err) {
    console.error(`\n❌ Impossible de se connecter à MongoDB (${MONGODB_URI_SAFE}).`);
    console.error('   Démarre un serveur MongoDB puis relance, par ex. :');
    console.error('     docker run -d -p 27017:27017 --name conquest-mongo mongo:7');
    // Le détail vient du driver, qui recrache volontiers l'URI COMPLÈTE reçue :
    // on l'expurge comme la nôtre avant de l'écrire dans les logs.
    console.error('   ou définis MONGODB_URI vers ton instance.\n   Détail : ' + maskCredentials(err.message || err));
    process.exit(1);
}

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

function normalizePort(val) {
    const port = parseInt(val, 10);
    if (isNaN(port)) return val; // named pipe
    if (port >= 0) return port; // port number
    return false;
}

function onError(error) {
    if (error.syscall !== 'listen') throw error;
    const bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;
    switch (error.code) {
        case 'EACCES':
            console.error(bind + ' requires elevated privileges');
            process.exit(1);
            break;
        case 'EADDRINUSE':
            console.error(bind + ' is already in use');
            process.exit(1);
            break;
        default:
            throw error;
    }
}

function onListening() {
    const addr = server.address();
    const bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
    debug('Listening on ' + bind);
    // eslint-disable-next-line no-console
    console.log(`Serveur Conquest en écoute sur http://localhost:${typeof addr === 'string' ? addr : addr.port}`);
    // eslint-disable-next-line no-console
    console.log('Page de test : http://localhost:' + (typeof addr === 'string' ? addr : addr.port) + '/test.html');
}
