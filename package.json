{
  "name": "conquest-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "shared-engine",
    "conquest-front",
    "conquest-back"
  ],
  "scripts": {
    "dev": "npm run dev -w conquest-front",
    "build": "npm run build -w conquest-front",
    "start": "npm start -w conquest-back",
    "lint": "npm run lint -w conquest-front",
    "test": "node --test \"shared-engine/test/*.test.js\"",
    "balance": "node shared-engine/balance/report.js"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.28.0"
  }
}
